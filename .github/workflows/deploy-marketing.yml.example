# Optional alternative to the Cloudflare Pages Git integration.
#
# Rename this file to `deploy-marketing.yml` to enable it, and set the secrets
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID first — without them the job
# fails on every push.
#
# Do not run this at the same time as the dashboard Git integration, or each
# push deploys twice. See docs/deploy-marketing.md.

name: Deploy marketing

on:
  push:
    branches: [main]
    paths:
      - 'marketing/**'
      - '.github/workflows/deploy-marketing.yml'
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      deployments: write
    steps:
      - uses: actions/checkout@v4

      - name: Publish to Cloudflare Pages
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy marketing/prebeta --project-name=marita-prebeta

      # Notify IndexNow-participating engines (Bing, Yandex, Seznam, Naver, Yep).
      # Google does not participate. Only fires when index.html actually changed,
      # so routine asset-only deploys do not spam the endpoint.
      - name: Check whether page content changed
        id: changed
        run: |
          if git diff --name-only HEAD~1 HEAD | grep -q '^marketing/prebeta/index.html$'; then
            echo "content=true" >> "$GITHUB_OUTPUT"
          else
            echo "content=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Submit to IndexNow
        if: steps.changed.outputs.content == 'true'
        run: scripts/indexnow.sh
